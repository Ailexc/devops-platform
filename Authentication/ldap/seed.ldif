# OpenLDAP 演示目录树（osixia/openldap 启动时通过 entrypoint 复制到 custom 目录导入）
# 顶层域名：dc=devops,dc=com；组织单元 ou=people 下放置全家桶统一用户
# 统一身份目录：认证中心作为 LDAP 认证源，所有业务系统共享该目录（身份统一、授权分散）
# 演示用户密码均为明文 demo1234（Demo 用；生产必须用 {SSHA}/{SSHA512} 哈希）
# 组织归属（departmentNumber）：用户隶属于组织，不隶属于任何系统

dn: ou=people,dc=devops,dc=com
objectClass: organizationalUnit
ou: people

# ---- 平台组 / 超管 ----
dn: uid=admin,ou=people,dc=devops,dc=com
objectClass: inetOrgPerson
objectClass: posixAccount
uid: admin
cn: 系统管理员
sn: 管理
displayName: 系统管理员
mail: admin@devops.com
departmentNumber: 平台组
uidNumber: 1004
gidNumber: 1004
homeDirectory: /home/admin
userPassword: demo1234

