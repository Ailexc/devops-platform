# ============================================================
# 本地部署环境变量（OrbStack / Docker 本地开发环境）
# 用法：set -a; source deploy/local/.env.local; set +a
#       或由 scripts/lib.sh 的 load_env() 自动加载（ENV=local）
# 原理：通过 docker compose 的 ${VAR:-default} 插值覆盖各项目默认值，
#      与 deploy/cloud/.env.cloud 一一对应 —— 本地/云端共用一套代码，
#      门户跳转地址按 ENV 实时加载，无需改代码。
# ============================================================

# ---- 统一网关入口（本地：OrbStack 自动 DNS + 端口 8088）----
#   门户直达：   http://devops.orb.local:8088  （或 portal.devops.orb.local:8088）
#   各系统访问： http://<系统>.devops.orb.local:8088
#   网关 Dashboard：http://traefik.devops.orb.local:8088/api/rawdata

# ---- 门户应用跳转地址（APP_URL_<APP_ID>，覆盖 seed.py 本地默认值）----
# 主系统走统一网关 Host 路由（*.devops.orb.local，OrbStack 自动 DNS）
APP_URL_TASK_MANAGER=http://cmdb.devops.orb.local
APP_URL_CLOUD_MANAGER=http://cloud.devops.orb.local
APP_URL_WORKFLOW_CENTER=http://workflow.devops.orb.local
APP_URL_EVENT_MANAGER=http://event.devops.orb.local
APP_URL_RELEASE_MANAGER=http://release.devops.orb.local
APP_URL_PERMISSION_CENTER=http://iam.devops.orb.local
APP_URL_LAM=http://localhost:8083
\n# ---- Mac 外呼代理（TaskManager AI/巡检外呼需要时取消注释；服务器留空 = 直连）----
# HTTP_PROXY=http://host.docker.internal:7897
# HTTPS_PROXY=http://host.docker.internal:7897
# ---- Demo 应用（OrbStack 自动 DNS / localhost 直连）----
APP_URL_MOCK_APP=http://mock.authentication.orb.local
APP_URL_DIRECT_APP=http://direct.authentication.orb.local
APP_URL_PILOT_APP=http://localhost:8004
APP_URL_OIDC_DEMO=http://localhost:8005
# oidc-demo 授权码流程本地地址（redirect_uri 与 home_url 匹配）
OIDC_REDIRECT_URI=http://localhost:8005/callback
OIDC_AUTHORIZE_URL=http://localhost:8002/oauth/authorize

# ---- CloudManager CORS / ALLOWED_HOSTS（本地默认值）----
DJANGO_ALLOWED_HOSTS=*,backend,cloud_manager_backend,cloud-manager-backend.orb.local
CORS_ALLOWED_ORIGINS=http://cloud-manager-nginx.orb.local,http://cloud-manager-backend.orb.local

# ---- 各系统 Django ALLOWED_HOSTS（TaskManager/EventManager/ReleaseManager 等由 compose 插值注入）----
ALLOWED_HOSTS=*,localhost,127.0.0.1,.devops.orb.local

# ---- 安全密钥（演示环境；生产请改为强随机）----
SECRET_KEY=devops-local-demo-secret-20260818
JWT_SECRET=devops-local-demo-jwt-20260818

# ---- 演示模式 ----
DEMO_MODE=1
GOARCH=arm64
