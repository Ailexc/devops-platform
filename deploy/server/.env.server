# ============================================================
# 自建服务器部署环境变量（通用：阿里云 / 腾讯云 / 自建内网 / NAS 等）
# 用法：ENV=server make start   或  make bootstrap（自动检测 deploy/server/.env.server）
# 原理：通过 docker compose 的 ${VAR:-default} 插值覆盖各项目默认值，
#       与 deploy/cloud/.env.cloud / deploy/local/.env.local 一一对应 ——
#       本地/云端/服务器共用一套代码，门户跳转地址按 ENV 实时加载。
# ============================================================

# ---- 服务器 IP（唯一需要改的值）----
SERVER_IP=192.168.3.155

# ---- 统一网关入口（多端口纯 IP，面试官无需 hosts 映射）----
#   门户直达：    http://${SERVER_IP}:8088
#   各系统访问：  http://${SERVER_IP}:<port>
#   网关 Dashboard：http://${SERVER_IP}:8088/api/rawdata

# ---- 门户地址（OIDC 等无 token 跳登录用）----
PORTAL_URL=http://${SERVER_IP}:8088

# ---- 门户应用跳转地址（APP_URL_<APP_ID>）----
APP_URL_TASK_MANAGER=http://${SERVER_IP}:8089
APP_URL_CLOUD_MANAGER=http://${SERVER_IP}:8090
APP_URL_WORKFLOW_CENTER=http://${SERVER_IP}:8091
APP_URL_EVENT_MANAGER=http://${SERVER_IP}:8092
APP_URL_RELEASE_MANAGER=http://${SERVER_IP}:8093
APP_URL_PERMISSION_CENTER=http://${SERVER_IP}:8094

# ---- Demo 应用跳转地址 ----
APP_URL_MOCK_APP=http://${SERVER_IP}:8095
APP_URL_DIRECT_APP=http://${SERVER_IP}:8096
APP_URL_PILOT_APP=http://${SERVER_IP}:8097
APP_URL_OIDC_DEMO=http://${SERVER_IP}:8098

# ---- oidc-demo 授权码流程地址 ----
OIDC_REDIRECT_URI=http://${SERVER_IP}:8098/callback
OIDC_AUTHORIZE_URL=http://${SERVER_IP}:8099/oauth/authorize

# ---- ReleaseManager OIDC 客户端（浏览器授权跳转；回跳 URI 由 APP_URL_RELEASE_MANAGER 派生）----
AUTH_AUTHORIZE_URL=http://${SERVER_IP}:8099/oauth/authorize

# ---- CloudManager CORS / ALLOWED_HOSTS ----
DJANGO_ALLOWED_HOSTS=*,backend,cloud_manager_backend,${SERVER_IP}
CORS_ALLOWED_ORIGINS=http://${SERVER_IP}:8088

# ---- 各系统 Django ALLOWED_HOSTS（TaskManager/EventManager/ReleaseManager 等）----
ALLOWED_HOSTS=*,localhost,127.0.0.1,${SERVER_IP}

# ---- 安全密钥（演示环境；生产请改为强随机）----
SECRET_KEY=devops-server-demo-secret-20260904
JWT_SECRET=devops-server-demo-jwt-20260904

# ---- 演示模式 ----
DEMO_MODE=1

# ---- 认证身份源（覆盖 Authentication/.env 的 local）：LDAP 优先（openldap 容器），本地兜底 ----
AUTH_PROVIDER_ORDER=ldap,local
AUTH_PROVIDER_LDAP_ENABLED=true
AUTH_PROVIDER_LOCAL_ENABLED=true
LDAP_ADMIN_PASSWORD=adminpass

# ---- LDAP Account Manager（LAM）管理台（:8083，独立登录 lam/adminpass）----
APP_URL_LAM=http://${SERVER_IP}:8083
