# ============================================================
# 云端部署环境变量（阿里云 ECS 专用）
# 用法：set -a; source deploy/cloud/.env.cloud; set +a
#       或由 scripts/deploy-cloud.sh 自动加载
# 原理：通过 docker compose 的 ${VAR:-default} 插值覆盖各项目本地默认值
#       （无需改动各项目 .env）
# ============================================================

# ---- 统一网关入口（ECS：IP + Host 头，端口 8088）----
#   门户直达：    http://114.55.244.220:8088   （网关 IP 兜底路由 → portal）
#   各系统访问：  http://<系统>.devops.orb.local:8088
#                 （客户端 hosts 映射：114.55.244.220  *.devops.orb.local）
#   网关 Dashboard：http://traefik.devops.orb.local:8088/api/rawdata

# ---- 门户应用跳转地址（APP_URL_<APP_ID>，覆盖 seed.py 本地默认值）----
# 方案 B：多端口纯 IP 直达，面试官无需 hosts 映射
APP_URL_TASK_MANAGER=http://114.55.244.220:8089
APP_URL_CLOUD_MANAGER=http://114.55.244.220:8090
APP_URL_WORKFLOW_CENTER=http://114.55.244.220:8091
APP_URL_EVENT_MANAGER=http://114.55.244.220:8092
APP_URL_RELEASE_MANAGER=http://114.55.244.220:8093
APP_URL_PERMISSION_CENTER=http://114.55.244.220:8094
# ---- Demo 应用（统一网关接管，端口 8095-8099）----
APP_URL_MOCK_APP=http://114.55.244.220:8095
APP_URL_DIRECT_APP=http://114.55.244.220:8096
APP_URL_PILOT_APP=http://114.55.244.220:8097
APP_URL_OIDC_DEMO=http://114.55.244.220:8098
# oidc-demo 授权码流程云端地址（redirect_uri 需与 home_url 匹配，authorize 走公网认证 API 入口）
OIDC_REDIRECT_URI=http://114.55.244.220:8098/callback
OIDC_AUTHORIZE_URL=http://114.55.244.220:8099/oauth/authorize
# 说明：token / userinfo 由 oidc-demo 后端经 devops-net 内部调用，无需公网地址。

# ---- CloudManager CORS / ALLOWED_HOSTS（覆盖默认里的 orb.local 域名）----
DJANGO_ALLOWED_HOSTS=*,backend,cloud_manager_backend,.devops.orb.local,114.55.244.220
CORS_ALLOWED_ORIGINS=http://cloud.devops.orb.local:8088,http://114.55.244.220:8088

# ---- 各系统 Django ALLOWED_HOSTS（TaskManager/EventManager/ReleaseManager 等由 compose 插值注入）----
# 含 114.55.244.220 云 IP：nginx 反代保留浏览器 Host 头，Django 需放行 IP 访问
ALLOWED_HOSTS=*,localhost,127.0.0.1,.devops.orb.local,114.55.244.220

# ---- 安全密钥（演示环境；生产请改为强随机）----
SECRET_KEY=devops-cloud-demo-secret-20260818
JWT_SECRET=devops-cloud-demo-jwt-20260818

# ---- 演示模式 ----
DEMO_MODE=1
