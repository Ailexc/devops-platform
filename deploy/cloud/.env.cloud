# ============================================================
# 云端部署环境变量（阿里云 ECS 专用）
# 用法：set -a; source deploy/cloud/.env.cloud; set +a
#       或由 scripts/deploy-cloud.sh 自动加载
# 原理：通过 docker compose 的 ${VAR:-default} 插值覆盖各项目本地默认值
#       （无需改动各项目 .env）
# ============================================================

# ---- 统一网关入口（ECS：IP + Host 头，端口 8088）----
#   门户直达：    http://112.124.69.224:8088   （网关 IP 兜底路由 → portal）
#   各系统访问：  http://<系统>.devops.orb.local:8088
#                 （客户端 hosts 映射：112.124.69.224  *.devops.orb.local）
#   网关 Dashboard：http://traefik.devops.orb.local:8088/api/rawdata

# ---- 门户应用跳转地址（APP_URL_<APP_ID>，覆盖 seed.py 本地默认值）----
APP_URL_TASK_MANAGER=http://cmdb.devops.orb.local:8088
APP_URL_CLOUD_MANAGER=http://cloud.devops.orb.local:8088
APP_URL_WORKFLOW_CENTER=http://workflow.devops.orb.local:8088
APP_URL_EVENT_MANAGER=http://event.devops.orb.local:8088
APP_URL_RELEASE_MANAGER=http://release.devops.orb.local:8088
APP_URL_PERMISSION_CENTER=http://iam.devops.orb.local:8088
# 说明：pilot-app / oidc-demo 为认证流程演示（redirect_uri 与 home_url 强关联），
#       云端不覆盖，保持 localhost 默认值。

# ---- CloudManager CORS / ALLOWED_HOSTS（覆盖默认里的 orb.local 域名）----
DJANGO_ALLOWED_HOSTS=*,backend,cloud_manager_backend,.devops.orb.local,112.124.69.224
CORS_ALLOWED_ORIGINS=http://cloud.devops.orb.local:8088,http://112.124.69.224:8088

# ---- 安全密钥（演示环境；生产请改为强随机）----
SECRET_KEY=devops-cloud-demo-secret-20260818
JWT_SECRET=devops-cloud-demo-jwt-20260818

# ---- 演示模式 ----
DEMO_MODE=1
