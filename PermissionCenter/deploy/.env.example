# 服务
IAM_HTTP_ADDR=:8080
IAM_LOG_LEVEL=info

# 数据库
PG_DSN=postgres://iam:iam@localhost:5432/iam?sslmode=disable

# Redis
REDIS_ADDR=localhost:6379

# JWT
JWT_SECRET=change-me-in-prod
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=168h

# OpenFGA（实例级关系引擎）
OPENFGA_ADDR=localhost:8081

# mock-cmdb / mock-identity（外部数据源/身份源）
CMDB_BASE_URL=http://localhost:8090
CMDB_WEBHOOK_TOKEN=cmdb-webhook-secret
IDENTITY_BASE_URL=http://localhost:8091

# PEP→PDP 共享密钥（防绕过网关直连 PDP）
PEP_SHARED_SECRET=pep-shared-secret
