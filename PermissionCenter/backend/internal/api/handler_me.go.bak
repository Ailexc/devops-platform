package api

import (
	"sort"
	"strconv"
	"strings"

	"github.com/gin-gonic/gin"
	"github.com/xcy/permission-center/internal/auth"
	"github.com/xcy/permission-center/internal/model"
)

// meOverview 工作台聚合（FR-1）
func (d *Deps) meOverview(c *gin.Context) {
	claims, ok := auth.ClaimsFrom(c)
	if !ok {
		c.JSON(401, gin.H{"error": "invalid token"})
		return
	}
	u, err := d.Users.ByUsername(claims.Username)
	if err != nil {
		c.JSON(404, gin.H{"error": "user not found"})
		return
	}
	uid := u.ID

	// 身份维度
	groups, _ := d.Groups.ByUserID(uid)
	orgs := filterGroups(groups, model.GroupTypeOrg)
	customGroups := filterGroups(groups, model.GroupTypeCustom)
	ownedApps, _ := d.Apps.ByOwnerID(uid)

	// 待办
	myRequests := d.countMyRequests(uid)
	pendingApprovals := d.countPendingApprovals(uid)

	// 权限计数（四维度）
	pc := d.permissionCounts(uid)

	// 组织身份：带树形路径（path_names）+ 我在组织中的角色（my_role）
	orgViews := make([]gin.H, 0, len(orgs))
	for _, g := range orgs {
		orgViews = append(orgViews, d.orgIdentityView(uid, g))
	}

	c.JSON(200, gin.H{
		"user": u,
		"identity": gin.H{
			"orgs":          orgViews,
			"custom_groups": customGroups,
			"owned_apps":    ownedApps,
			"approver":      pendingApprovals > 0 || d.isApprover(uid),
		},
		"permission_counts": pc,
		"todos": gin.H{
			"pending_approvals":    pendingApprovals,
			"in_progress_requests": myRequests,
		},
	})
}

// mePermissions 我的权限聚合（FR-2.2）：组织继承 / 个人权限 / 自建组权限
// 临时 TTL 不再是独立维度：并入个人权限，作为 expires_at 属性展示
func (d *Deps) mePermissions(c *gin.Context) {
	uid := d.currentUserID(c)
	if uid == 0 {
		c.JSON(401, gin.H{"error": "invalid token"})
		return
	}
	groups, _ := d.Groups.ByUserID(uid)
	groupIDs := d.allGroupIDsForUser(uid, groups)

	// 个人直接授权：subject_type=user 且 subject_id=uid（含 TTL 权限，属性展示）
	personal := d.personalPolicies(uid)
	// 自建组 + 组织：组权限点
	orgPerms, groupPerms := d.groupActionRecords(uid, groupIDs, groups)

	c.JSON(200, gin.H{
		"organization": orgPerms,
		"personal":     personal,
		"custom_group": groupPerms,
	})
}

// meOrgPermissions 组织权限（FR-2.1）：我的直接隶属组织 + 子树只读可见性
func (d *Deps) meOrgPermissions(c *gin.Context) {
	uid := d.currentUserID(c)
	if uid == 0 {
		c.JSON(401, gin.H{"error": "invalid token"})
		return
	}
	groups, _ := d.Groups.ByUserID(uid)
	orgs := filterGroups(groups, model.GroupTypeOrg)

	type orgView struct {
		model.Group
		IsLeaf             bool           `json:"is_leaf"`
		PathNames          []string       `json:"path_names"`           // 树形路径：["总公司","研发中心","研发一部"]
		Permissions        []model.Action `json:"permissions"`          // 兼容：接口列表
		PermissionApps     []gin.H        `json:"permission_apps"`      // 按应用分组的接口权限
		DataPermissionApps []gin.H        `json:"data_permission_apps"` // 按应用分组的数据权限（含授权来源）
		Members            []gin.H        `json:"members"`              // 成员（含角色）
		SubOrgs            []*orgView     `json:"sub_orgs,omitempty"`
		Readonly           bool           `json:"readonly"` // 父级只读
		Accessors          []gin.H        `json:"accessors,omitempty"`
	}
	build := func(g model.Group) *orgView {
		ids, _ := d.Access.GroupPermissionIDs(g.ID)
		acts, _ := d.Access.ActionsByIDs(ids)
		members, _ := d.Groups.Members(g.ID)
		return &orgView{
			Group: g, IsLeaf: d.isLeafOrg(g.ID),
			PathNames:          d.orgPathNames(g),
			Permissions:        acts,
			PermissionApps:     d.groupActionsByApp(g.ID, acts),
			DataPermissionApps: d.groupDataPoliciesByApp(g.ID),
			Members:            d.membersView(g.ID, members),
			Readonly:           !d.isLeafOrg(g.ID),
		}
	}

	views := make([]*orgView, 0)
	// 子树可见性：直接隶属的每个 org 节点 → 其子树只读可见
	for _, g := range orgs {
		v := build(g)
		// 子组织（子树只读）
		var sub []*orgView
		subIDs, _ := d.Groups.SubtreeIDs(g.Path)
		for _, sid := range subIDs {
			if sid == g.ID {
				continue
			}
			if sg, err := d.Groups.ByID(sid); err == nil && sg.Type == model.GroupTypeOrg {
				sub = append(sub, build(*sg))
			}
		}
		sort.Slice(sub, func(i, j int) bool { return sub[i].Path < sub[j].Path })
		v.SubOrgs = sub
		// 组内应用：本组织拥有/注册应用的授权账本
		v.Accessors = d.orgAccessors(g.ID)
		views = append(views, v)
	}
	c.JSON(200, gin.H{"items": views})
}

// meGroups 自建组 + 我的身份（FR-2.3 / FR-2.4）
func (d *Deps) meGroups(c *gin.Context) {
	uid := d.currentUserID(c)
	if uid == 0 {
		c.JSON(401, gin.H{"error": "invalid token"})
		return
	}
	groups, _ := d.Groups.ByUserID(uid)
	custom := filterGroups(groups, model.GroupTypeCustom)

	type groupView struct {
		model.Group
		MyRole   int16        `json:"my_role"`
		Members  []model.User `json:"members"`
		Actions  []model.Action `json:"permissions"`
	}
	items := make([]groupView, 0, len(custom))
	for _, g := range custom {
		role := int16(model.GroupRoleMember)
		members, _ := d.Groups.Members(g.ID)
		for _, m := range members {
			if m.ID == uid {
				var ug model.UserGroup
				d.DB.Where("user_id = ? AND group_id = ?", uid, g.ID).First(&ug)
				if ug.Role == model.GroupRoleAdmin {
					role = model.GroupRoleAdmin
				}
			}
		}
		ids, _ := d.Access.GroupPermissionIDs(g.ID)
		acts, _ := d.Access.ActionsByIDs(ids)
		items = append(items, groupView{Group: g, MyRole: role, Members: members, Actions: acts})
	}
	c.JSON(200, gin.H{"items": items})
}

// ---- 内部辅助 ----

func filterGroups(gs []model.Group, gtype int16) []model.Group {
	var out []model.Group
	for _, g := range gs {
		if g.Type == gtype {
			out = append(out, g)
		}
	}
	return out
}

// allGroupIDsForUser 用户全部组（直接成员 + org 祖先展开）
func (d *Deps) allGroupIDsForUser(uid uint64, groups []model.Group) []uint64 {
	ids, _ := d.Groups.MemberGroupIDs(uid)
	// MemberGroupIDs 已展开祖先链；直接成员组（custom）也含在内
	_ = groups
	return ids
}

// meCapabilityPermissions 我的权限（能力包维度）：个人 / 组织 / 自建组 三个维度，
// 数据源 = 已通过的能力包申请单（每条授权必有申请单留痕）
func (d *Deps) meCapabilityPermissions(c *gin.Context) {
	uid := d.currentUserID(c)
	groups, _ := d.Groups.ByUserID(uid)
	groupIDs := map[uint64]bool{}
	orgIDs := map[uint64]bool{}
	for _, g := range groups {
		groupIDs[g.ID] = true
		if g.Type == model.GroupTypeOrg {
			orgIDs[g.ID] = true
		}
	}
	for _, id := range d.allGroupIDsForUser(uid, groups) {
		groupIDs[id] = true
	}

	var reqs []model.AccessRequest
	d.DB.Where("status = ? AND request_type != ?", model.ReqApproved, model.RequestOnboard).
		Order("id desc").Limit(300).Find(&reqs)

	personal, org, grp := []gin.H{}, []gin.H{}, []gin.H{}
	for _, r := range reqs {
		cid, _ := r.Content["capability_id"].(float64)
		if cid == 0 {
			continue
		}
		cap, err := d.Caps.ByID(uint64(cid))
		if err != nil {
			continue
		}
		pid, _ := r.Content["preset_id"].(string)
		presetName := pid
		if p := d.findPreset(cap.Presets, pid); p != nil {
			if n, ok := p["name"].(string); ok {
				presetName = n
			}
		}
		appName := ""
		if a, err := d.Apps.ByID(cap.AppID); err == nil {
			appName = a.Name
		}
		// 预设接口解析（能力包详情展示）
		var interfaces []string
		if p := d.findPreset(cap.Presets, pid); p != nil {
			if v, ok := p["action_codes"].([]any); ok {
				for _, x := range v {
					if code, ok := x.(string); ok {
						interfaces = append(interfaces, code)
					}
				}
			}
		}
		item := gin.H{
			"request_id":     r.ID,
			"capability_id":  cap.ID,
			"capability_name": cap.Name,
			"description":    cap.Description,
			"app_name":       appName,
			"preset_name":    presetName,
			"scope_text":     selectionsText(scopeSelectionsOf(r.Content)),
			"created_at":     r.CreatedAt.Format("2006-01-02 15:04"),
			"grantee_type":   r.GranteeType,
			"grantee_name":   r.GranteeName,
			"grantee_id":     r.GranteeID,
			"interfaces":     interfaces,
			"request_status": r.Status,
			"risk_level":     r.RiskLevel,
			"reason":         r.Reason,
		}
		switch r.GranteeType {
		case model.GranteeUser:
			if r.GranteeID == uid {
				personal = append(personal, item)
			}
		case model.GranteeOrg:
			if orgIDs[r.GranteeID] {
				org = append(org, item)
			}
		case model.GranteeGroup:
			if groupIDs[r.GranteeID] {
				grp = append(grp, item)
			}
		}
	}
	c.JSON(200, gin.H{"personal": personal, "org": org, "group": grp})
}

func scopeSelectionsOf(content model.JSONMap) []map[string]any {
	var out []map[string]any
	if v, ok := content["scope_selections"].([]any); ok {
		for _, x := range v {
			if m, ok := x.(map[string]any); ok {
				out = append(out, m)
			}
		}
	}
	return out
}

func (d *Deps) isLeafOrg(groupID uint64) bool {
	var count int64
	d.DB.Model(&model.Group{}).Where("parent_id = ? AND type = ?", groupID, model.GroupTypeOrg).Count(&count)
	return count == 0
}

// personalPolicies 个人直接授权（subject=user）
func (d *Deps) personalPolicies(uid uint64) []gin.H {
	var ps []model.Policy
	d.DB.Where("subject_type = ? AND subject_id = ? AND status = ?",
		model.SubjectUser, uid, model.PolicyActive).Find(&ps)
	return d.decoratePolicies(ps)
}

// groupActionRecords 组权限记录：org 组 → organization 维度；custom 组 → custom_group 维度
func (d *Deps) groupActionRecords(uid uint64, groupIDs []uint64, groups []model.Group) ([]gin.H, []gin.H) {
	orgOut := make([]gin.H, 0)
	grpOut := make([]gin.H, 0)
	if len(groupIDs) == 0 {
		return orgOut, grpOut
	}
	var gps []model.GroupPermission
	d.DB.Where("group_id IN ?", groupIDs).Find(&gps)
	if len(gps) == 0 {
		return orgOut, grpOut
	}
	// group → 名称/类型
	groupByID := map[uint64]model.Group{}
	for _, g := range groups {
		groupByID[g.ID] = g
	}
	// 补全祖先组（MemberGroupIDs 含祖先）
	for _, id := range groupIDs {
		if _, ok := groupByID[id]; !ok {
			if g, err := d.Groups.ByID(id); err == nil {
				groupByID[id] = *g
			}
		}
	}
	byGroup := map[uint64][]uint64{}
	for _, gp := range gps {
		byGroup[gp.GroupID] = append(byGroup[gp.GroupID], gp.ActionID)
	}
	for gid, aids := range byGroup {
		g, ok := groupByID[gid]
		if !ok {
			continue
		}
		acts, _ := d.Access.ActionsByIDs(aids)
		rec := gin.H{
			"group_id":             gid,
			"group_name":           g.Name,
			"group_type":           g.Type,
			"path_names":           d.orgPathNames(g), // 树形路径（org 维度）
			"actions":              acts,
			"permission_apps":      d.groupActionsByApp(gid, acts),      // 按应用分组的接口权限
			"data_permission_apps": d.groupDataPoliciesByApp(gid), // 按应用分组的数据权限（含授权来源）
		}
		if g.Type == model.GroupTypeOrg {
			orgOut = append(orgOut, rec)
		} else {
			grpOut = append(grpOut, rec)
		}
	}
	return orgOut, grpOut
}

// orgPathNames 物化路径 → 祖先链名称（["总公司","研发中心","研发一部"]）
func (d *Deps) orgPathNames(g model.Group) []string {
	var names []string
	if g.Path == "" {
		return names
	}
	trimmed := strings.Trim(g.Path, "/")
	if trimmed == "" {
		return names
	}
	for _, idStr := range strings.Split(trimmed, "/") {
		id, _ := strconv.ParseUint(idStr, 10, 64)
		if id == 0 {
			continue
		}
		if node, err := d.Groups.ByID(id); err == nil {
			names = append(names, node.Name)
		}
	}
	return names
}

// groupActionsByApp 动作列表按应用分组 → [{app_id, app_code, app_name, actions:[{id,code,name,method,path, request_id, request_reason}]}]
// 前端按应用展示接口：GET /api/v1/hosts；groupID>0 时附加接口权限的申请单来源（组长申请留痕）
func (d *Deps) groupActionsByApp(groupID uint64, acts []model.Action) []gin.H {
	// 组权限申请单来源（GroupPermission.RequestID）
	reqByAction := map[uint64]gin.H{}
	if groupID > 0 {
		var gps []model.GroupPermission
		d.DB.Where("group_id = ? AND request_id IS NOT NULL", groupID).Find(&gps)
		seen := map[uint64]bool{}
		for _, gp := range gps {
			if gp.RequestID == nil || seen[gp.ActionID] {
				continue
			}
			seen[gp.ActionID] = true
			var r model.AccessRequest
			if err := d.DB.First(&r, *gp.RequestID).Error; err == nil {
				reqByAction[gp.ActionID] = gin.H{
					"request_id":  r.ID,
					"request_applicant": r.ApplicantID,
					"request_reason":    r.Reason,
					"request_status":    r.Status,
				}
			}
		}
	}
	appMap := map[uint64]*gin.H{}
	var order []uint64
	for _, a := range acts {
		view, ok := appMap[a.AppID]
		if !ok {
			app, _ := d.Apps.ByID(a.AppID)
			v := gin.H{"app_id": a.AppID, "app_code": "", "app_name": "", "actions": []gin.H{}}
			if app != nil {
				v["app_code"] = app.Code
				v["app_name"] = app.Name
			}
			view = &v
			appMap[a.AppID] = view
			order = append(order, a.AppID)
		}
		actsView := (*view)["actions"].([]gin.H)
		item := gin.H{
			"id": a.ID, "code": a.Code, "name": a.Name,
			"method": a.Method, "path": a.Path, "operation": a.Operation,
			"is_generic": a.IsGeneric, "resource_slot": a.ResourceSlot,
		}
		if src, ok := reqByAction[a.ID]; ok {
			for k, v := range src {
				item[k] = v
			}
		}
		actsView = append(actsView, item)
		(*view)["actions"] = actsView
	}
	out := make([]gin.H, 0, len(order))
	for _, id := range order {
		out = append(out, *appMap[id])
	}
	return out
}

// groupDataPoliciesByApp 组数据权限（subject=group 的 active 数据策略）按应用分组
// 每条含授权来源：申请单号 / 发起人（组长申请还是组员申请）/ 理由 / 审批链
func (d *Deps) groupDataPoliciesByApp(groupID uint64) []gin.H {
	var ps []model.Policy
	d.DB.Where("subject_type = ? AND subject_id = ? AND status = ?",
		model.SubjectGroup, groupID, model.PolicyActive).Find(&ps)

	appMap := map[uint64]*gin.H{}
	var order []uint64
	for _, p := range ps {
		if p.ResourceScope == nil {
			continue // 非数据策略跳过
		}
		view, ok := appMap[p.AppID]
		if !ok {
			app, _ := d.Apps.ByID(p.AppID)
			v := gin.H{"app_id": p.AppID, "app_code": "", "app_name": "", "permissions": []gin.H{}}
			if app != nil {
				v["app_code"] = app.Code
				v["app_name"] = app.Name
			}
			view = &v
			appMap[p.AppID] = view
			order = append(order, p.AppID)
		}
		perms := (*view)["permissions"].([]gin.H)
		perm := gin.H{
			"id":              p.ID,
			"name":            p.Name,
			"data_scope":      d.decorateDataScope(p.ResourceScope),
			"expires_at":      p.ExpiresAt,
			"request_id":      p.RequestID,
			"source":          p.Source,
			"created_by":      p.CreatedBy,
			"created_by_name": "",
			"reason":          "",
		}
		if p.CreatedBy > 0 {
			if u, err := d.Users.ByID(p.CreatedBy); err == nil {
				perm["created_by_name"] = u.DisplayName
			}
		}
		// 授权来源：申请单 + 理由 + 审批链（"谁申请的、哪张单"）
		if p.RequestID != nil {
			var r model.AccessRequest
			if err := d.DB.First(&r, *p.RequestID).Error; err == nil {
				perm["reason"] = r.Reason
				perm["request_status"] = r.Status
				var tasks []model.ApprovalTask
				d.DB.Where("request_id = ?", r.ID).Order("step").Find(&tasks)
				approvers := make([]gin.H, 0)
				for _, t := range tasks {
					name := ""
					if au, err := d.Users.ByID(t.ApproverID); err == nil {
						name = au.DisplayName
					}
					approvers = append(approvers, gin.H{"name": name, "action": t.Action, "comment": t.Comment})
				}
				perm["approvals"] = approvers
			}
		}
		perms = append(perms, perm)
		(*view)["permissions"] = perms
	}
	out := make([]gin.H, 0, len(order))
	for _, id := range order {
		out = append(out, *appMap[id])
	}
	return out
}

// orgIdentityView 组织身份视图（树形路径 + 我在组织中的角色）
func (d *Deps) orgIdentityView(uid uint64, g model.Group) gin.H {
	role := int16(model.GroupRoleMember)
	var ug model.UserGroup
	if err := d.DB.Where("user_id = ? AND group_id = ?", uid, g.ID).First(&ug).Error; err == nil {
		role = ug.Role
	}
	return gin.H{
		"id": g.ID, "name": g.Name, "type": g.Type,
		"path_names": d.orgPathNames(g), "my_role": role,
	}
}

// membersView 组成员 → 展示视图（含角色：组长/成员）
func (d *Deps) membersView(groupID uint64, members []model.User) []gin.H {
	out := make([]gin.H, 0, len(members))
	roleByID := map[uint64]int16{}
	var ugs []model.UserGroup
	d.DB.Where("group_id = ?", groupID).Find(&ugs)
	for _, ug := range ugs {
		roleByID[ug.UserID] = ug.Role
	}
	for _, m := range members {
		out = append(out, gin.H{
			"id": m.ID, "username": m.Username, "display_name": m.DisplayName,
			"role": roleByID[m.ID],
		})
	}
	return out
}

// decoratePolicies 策略 → 展示记录（应用/接口/数据实例/理由 + TTL 属性 + 授权链留痕）
func (d *Deps) decoratePolicies(ps []model.Policy) []gin.H {
	out := make([]gin.H, 0, len(ps))
	for _, p := range ps {
		acts, _ := d.Access.ActionsByIDs(p.ActionIDs)
		rec := gin.H{
			"id":              p.ID,
			"name":            p.Name,
			"effect":          p.Effect,
			"app_id":          p.AppID,
			"actions":         acts,
			"data_scope_type": p.DataScopeType,
			"data_scope":      d.decorateDataScope(p.ResourceScope), // 数据实例可读化
			"resource_scope":  p.ResourceScope,
			"source":          p.Source,
			"created_by":      p.CreatedBy,
			"created_at":      p.CreatedAt,
			"expires_at":      p.ExpiresAt, // TTL 并入：非空即有有效期
			"capability_id":   p.CapabilityID,
			"request_id":      p.RequestID,
			"reason":          "", // 授权理由（从申请单）
		}
		// 应用名称
		if a, err := d.Apps.ByID(p.AppID); err == nil {
			rec["app_code"] = a.Code
			rec["app_name"] = a.Name
		}
		// 授予人名称
		if p.CreatedBy > 0 {
			if g, err := d.Users.ByID(p.CreatedBy); err == nil {
				rec["granted_by_name"] = g.DisplayName
			}
		}
		// 授权链 + 理由：申请单 + 审批人（留痕："为什么给我授权"）
		if p.RequestID != nil {
			var r model.AccessRequest
			if err := d.DB.First(&r, *p.RequestID).Error; err == nil {
				rec["reason"] = r.Reason
				var tasks []model.ApprovalTask
				d.DB.Where("request_id = ?", r.ID).Find(&tasks)
				approvers := make([]gin.H, 0)
				for _, t := range tasks {
					name := ""
					if au, err := d.Users.ByID(t.ApproverID); err == nil {
						name = au.DisplayName
					}
					approvers = append(approvers, gin.H{"approver_id": t.ApproverID, "name": name, "action": t.Action, "comment": t.Comment})
				}
				rec["grant_chain"] = gin.H{
					"request_id": r.ID, "status": r.Status,
					"risk_level": r.RiskLevel, "approvals": approvers,
				}
			}
		}
		out = append(out, rec)
	}
	return out
}

// decorateDataScope 数据范围可读化：{model, operation, instance_ids} → 实例名列表
func (d *Deps) decorateDataScope(scope model.JSONMap) gin.H {
	out := gin.H{"model": "", "operation": "", "instances": []gin.H{}}
	if scope == nil {
		return out
	}
	if v, ok := scope["model"].(string); ok {
		out["model"] = v
	}
	if v, ok := scope["operation"].(string); ok {
		out["operation"] = v
	}
	var ids []uint64
	switch raw := scope["instance_ids"].(type) {
	case []uint64:
		ids = raw
	case []any:
		for _, v := range raw {
			switch t := v.(type) {
			case float64:
				ids = append(ids, uint64(t))
			case uint64:
				ids = append(ids, t)
			}
		}
	}
	if len(ids) > 0 {
		insts, _ := d.Res.InstancesByIDs(ids)
		items := make([]gin.H, 0, len(insts))
		for _, in := range insts {
			items = append(items, gin.H{"id": in.ID, "name": in.Name, "external_id": in.ExternalID})
		}
		out["instances"] = items
	}
	return out
}

// permissionCounts 三维度权限计数（organization/personal/custom_group）
func (d *Deps) permissionCounts(uid uint64) gin.H {
	groups, _ := d.Groups.ByUserID(uid)
	groupIDs := d.allGroupIDsForUser(uid, groups)

	orgN, grpN := 0, 0
	if len(groupIDs) > 0 {
		var gps []model.GroupPermission
		d.DB.Where("group_id IN ?", groupIDs).Find(&gps)
		seen := map[uint64]bool{}
		for _, gp := range gps {
			seen[gp.ActionID] = true
		}
		orgN = len(seen)
		grpN = orgN
	}
	personal := d.personalPolicies(uid)
	return gin.H{
		"organization": orgN,
		"personal":     len(personal),
		"custom_group": grpN,
	}
}

func (d *Deps) countMyRequests(uid uint64) int {
	var count int64
	d.DB.Model(&model.AccessRequest{}).
		Where("applicant_id = ? AND status = ?", uid, model.ReqPending).Count(&count)
	return int(count)
}

func (d *Deps) countPendingApprovals(uid uint64) int {
	var rs []model.AccessRequest
	d.DB.Where("status = ?", model.ReqPending).Find(&rs)
	n := 0
	for _, r := range rs {
		app, err := d.Apps.ByID(r.AppID)
		if err != nil {
			continue
		}
		chain := d.buildApprovalChain(&r, app, r.ApplicantID)
		if d.inChain(uid, chain) {
			n++
		}
	}
	return n
}

func (d *Deps) isApprover(uid uint64) bool {
	// 应用 owner 或组 admin 或 admin 用户
	var ownerCount int64
	d.DB.Model(&model.AppOwner{}).Where("user_id = ?", uid).Count(&ownerCount)
	if ownerCount > 0 {
		return true
	}
	var adminCount int64
	d.DB.Model(&model.UserGroup{}).Where("user_id = ? AND role = ?", uid, model.GroupRoleAdmin).Count(&adminCount)
	return adminCount > 0
}

// orgAccessors 组织下拥有的应用的授权账本（组内应用：谁在访问我们的应用）
func (d *Deps) orgAccessors(orgID uint64) []gin.H {
	// demo 简化：返回该组织拥有（owner_group_id）的应用 + 组织直接授权的策略
	out := make([]gin.H, 0)
	var apps []model.App
	d.DB.Where("owner_group_id = ?", orgID).Find(&apps)
	for _, a := range apps {
		out = append(out, gin.H{
			"app_id": a.ID, "code": a.Code, "name": a.Name,
			"accessors": d.appAccessorSummary(a.ID),
		})
	}
	return out
}

// appAccessorSummary 应用被访问者摘要（按主体类型聚合）
func (d *Deps) appAccessorSummary(appID uint64) []gin.H {
	var ps []model.Policy
	d.DB.Where("app_id = ? AND status = ? AND effect = ?", appID, model.PolicyActive, model.EffectAllow).Find(&ps)
	seen := map[string]gin.H{}
	for _, p := range ps {
		key := strconv.FormatInt(int64(p.SubjectType), 10) + ":" + strconv.FormatUint(p.SubjectID, 10)
		if _, ok := seen[key]; !ok {
			seen[key] = gin.H{"subject_type": p.SubjectType, "subject_id": p.SubjectID}
		}
	}
	var out []gin.H
	for _, v := range seen {
		out = append(out, v)
	}
	return out
}
