# 多阶段构建：在容器内编译 Go 代码
FROM golang:1.23-alpine AS builder
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 GOOS=linux GOARCH=arm64 go build -o bin/iam-server ./cmd/iam-server && \
    CGO_ENABLED=0 GOOS=linux GOARCH=arm64 go build -o bin/mock-cmdb ./cmd/mock-cmdb && \
    CGO_ENABLED=0 GOOS=linux GOARCH=arm64 go build -o bin/mock-identity ./cmd/mock-identity && \
    CGO_ENABLED=0 GOOS=linux GOARCH=arm64 go build -o bin/iam-agent ./cmd/iam-agent

FROM alpine:3.20
RUN apk add --no-cache ca-certificates tzdata
COPY --from=builder /src/bin/ /usr/local/bin/
WORKDIR /app
EXPOSE 8080 8090 8091 9090
ENTRYPOINT []
