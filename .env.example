# ============================================================
# DevOpsPlatform 统一环境变量模板
# 复制为 .env 后按需修改；接入统一数据层后各项目以此为统一连接
# ============================================================

# ---- 统一基础设施（容器内地址，业务容器需加入 devops-net 网络）----
POSTGRES_HOST=devops-postgres
POSTGRES_PORT=5432
POSTGRES_USER=devops
POSTGRES_PASSWORD=devops
POSTGRES_DB=devops            # 默认库（各业务库为 devops_<项目>）

REDIS_HOST=devops-redis
REDIS_PORT=6379

# 各项目统一连接串（按项目替换库名，Redis 按 db index 隔离 0~6）
# DATABASE_URL=postgresql://devops:devops@devops-postgres:5432/devops_<项目>
# REDIS_URL=redis://devops-redis:6379/<0-6>

# ---- 通用密钥（各项目可覆盖）----
SECRET_KEY=change-me-in-prod
JWT_SECRET=change-me-jwt-secret

# ---- 面试演示 ----
# RESET_ON_START=1            # 启动时先全量重置再种子（"恢复出厂态"）
# DEMO_MODE=1                 # 演示模式（Celery 用 EAGER 等，按项目约定）
