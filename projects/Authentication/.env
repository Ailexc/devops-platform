# 显式设置项目名（连字符格式，匹配 OrbStack 域名）
COMPOSE_PROJECT_NAME=authentication

# ---- 身份源（降级链）----
# 顺序 = 优先级，逗号分隔；如 "ldap,local" 表示先 LDAP 后本地
AUTH_PROVIDER_ORDER=local
AUTH_PROVIDER_LOCAL_ENABLED=true
AUTH_PROVIDER_LDAP_ENABLED=false

# ---- LDAP（打开 LDAP 身份源时配置）----
LDAP_ADMIN_PASSWORD=adminpass
# osixia/openldap 容器内端口 389
LDAP_SERVER_URI=ldap://openldap:389
LDAP_BIND_DN=cn=admin,dc=devops,dc=com
LDAP_USER_SEARCH_BASE=ou=people,dc=devops,dc=com
LDAP_USER_SEARCH_FILTER=(uid={username})
