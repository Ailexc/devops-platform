# Docker Compose 项目名称
COMPOSE_PROJECT_NAME=workflow

# Django Secret Key（生产环境请更换）
SECRET_KEY=django-insecure-dev-key-change-in-production

# ============================================================
# AI 配置（用于 AI 表单生成，默认使用小米 MiMo）
# 注意：API Key 仅通过环境变量注入，前端「AI 模型配置」不再保存密钥。
# API Base 可只填前缀（如 .../v1），后端会自动补全 /chat/completions。
# ============================================================
AI_DEFAULT_PROVIDER=xiaomi

# 小米 MiMo
AI_XIAOMI_API_KEY=your_mimo_api_key_here
AI_XIAOMI_API_BASE=https://api.xiaomimimo.com/v1

# OpenAI
AI_OPENAI_API_KEY=your_api_key_here
AI_OPENAI_API_BASE=https://api.openai.com/v1

# DeepSeek
AI_DEEPSEEK_API_KEY=your_api_key_here
AI_DEEPSEEK_API_BASE=https://api.deepseek.com/v1

# 智谱 GLM
AI_ZHIPU_API_KEY=your_api_key_here
AI_ZHIPU_API_BASE=https://open.bigmodel.cn/api/paas/v4

# 通义千问
AI_QWEN_API_KEY=your_api_key_here
AI_QWEN_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1

# 本地 Ollama（容器内使用 host.docker.internal 访问宿主机）
AI_OLLAMA_API_BASE=http://host.docker.internal:11434/v1
