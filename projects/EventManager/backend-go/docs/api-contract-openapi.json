ail Type", "type": "string"}, "resource_id": {"default": "", "title": "Resource Id", "type": "string"}, "raw_payload": {"additionalProperties": true, "default": {}, "title": "Raw Payload", "type": "object"}, "max_retries": {"default": 5, "title": "Max Retries", "type": "integer"}}, "required": ["event_type"], "title": "EventCreate", "type": "object"}, "EventListOut": {"properties": {"items": {"items": {"$ref": "#/components/schemas/EventOut"}, "title": "Items", "type": "array"}, "total": {"title": "Total", "type": "integer"}, "page": {"title": "Page", "type": "integer"}, "page_size": {"title": "Page Size", "type": "integer"}}, "required": ["items", "total", "page", "page_size"], "title": "EventListOut", "type": "object"}, "EventLogOut": {"properties": {"id": {"title": "Id", "type": "integer"}, "action": {"title": "Action", "type": "string"}, "detail": {"additionalProperties": true, "title": "Detail", "type": "object"}, "created_at": {"format": "date-time", "title": "Created At", "type": "string"}}, "required": ["id", "action", "detail", "created_at"], "title": "EventLogOut", "type": "object"}, "RetryRequest": {"properties": {"force": {"default": false, "title": "Force", "type": "boolean"}}, "title": "RetryRequest", "type": "object"}, "DlqReplayRequest": {"properties": {"event_ids": {"items": {"format": "uuid", "type": "string"}, "title": "Event Ids", "type": "array"}}, "required": ["event_ids"], "title": "DlqReplayRequest", "type": "object"}, "StatsOut": {"properties": {"total": {"title": "Total", "type": "integer"}, "by_status": {"additionalProperties": {"type": "integer"}, "title": "By Status", "type": "object"}, "success_rate": {"title": "Success Rate", "type": "number"}, "avg_duration": {"anyOf": [{"type": "number"}, {"type": "null"}], "title": "Avg Duration"}, "p99_duration": {"anyOf": [{"type": "number"}, {"type": "null"}], "title": "P99 Duration"}, "queue_depth": {"default": 0, "title": "Queue Depth", "type": "integer"}}, "required": ["total", "by_status", "success_rate"], "title": "StatsOut", "type": "object"}, "TaskInfo": {"properties": {"id": {"title": "Id", "type": "string"}, "name": {"title": "Name", "type": "string"}, "description": {"title": "Description", "type": "string"}, "duration": {"title": "Duration", "type": "string"}, "max_count": {"title": "Max Count", "type": "integer"}, "default_count": {"title": "Default Count", "type": "integer"}}, "required": ["id", "name", "description", "duration", "max_count", "default_count"], "title": "TaskInfo", "type": "object"}, "TriggerResponse": {"properties": {"task_id": {"title": "Task Id", "type": "string"}, "celery_task_id": {"title": "Celery Task Id", "type": "string"}, "count": {"title": "Count", "type": "integer"}, "batch_id": {"title": "Batch Id", "type": "string"}, "message": {"title": "Message", "type": "string"}}, "required": ["task_id", "celery_task_id", "count", "batch_id", "message"], "title": "TriggerResponse", "type": "object"}, "TriggerRequest": {"properties": {"task_id": {"description": "\u4efb\u52a1 ID: fast \u6216 slow", "title": "Task Id", "type": "string"}, "count": {"default": 1, "description": "\u89e6\u53d1\u6570\u91cf", "maximum": 50, "minimum": 1, "title": "Count", "type": "integer"}}, "required": ["task_id"], "title": "TriggerRequest", "type": "object"}, "TaskStatusResponse": {"properties": {"celery_task_id": {"title": "Celery Task Id", "type": "string"}, "state": {"title": "State", "type": "string"}, "meta": {"anyOf": [{"additionalProperties": true, "type": "object"}, {"type": "null"}], "title": "Meta"}, "result": {"anyOf": [{"additionalProperties": true, "type": "object"}, {"type": "null"}], "title": "Result"}, "event_ids": {"default": [], "items": {"type": "string"}, "title": "Event Ids", "type": "array"}}, "required": ["celery_task_id", "state"], "title": "TaskStatusResponse", "type": "object"}, "FilePreviewResponse": {"properties": {"filename": {"title": "Filename", "type": "string"}, "size": {"title": "Size", "type": "integer"}, "content":