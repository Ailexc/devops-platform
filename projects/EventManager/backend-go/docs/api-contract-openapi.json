{"openapi": "3.1.0", "info": {"title": "EventFlow API", "version": "0.1.0", "description": "\u4e8b\u4ef6\u7ba1\u7406\u7cfb\u7edf API"}, "paths": {"/api/v1/events": {"post": {"operationId": "api_v1_events_create_event", "summary": "Create Event", "parameters": [], "responses": {"201": {"description": "Created", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/EventOut"}}}}}, "description": "\u63a5\u6536\u4e8b\u4ef6\uff0c\u8fd4\u56de 202 Accepted", "tags": ["\u4e8b\u4ef6"], "requestBody": {"content": {"application/json": {"schema": {"$ref": "#/components/schemas/EventCreate"}}}, "required": true}}, "get": {"operationId": "api_v1_events_list_events", "summary": "List Events", "parameters": [{"in": "query", "name": "page", "schema": {"default": 1, "title": "Page", "type": "integer"}, "required": false}, {"in": "query", "name": "page_size", "schema": {"default": 20, "title": "Page Size", "type": "integer"}, "required": false}, {"in": "query", "name": "status", "schema": {"anyOf": [{"type": "string"}, {"type": "null"}], "title": "Status"}, "required": false}, {"in": "query", "name": "event_type", "schema": {"anyOf": [{"type": "string"}, {"type": "null"}], "title": "Event Type"}, "required": false}, {"in": "query", "name": "source", "schema": {"anyOf": [{"type": "string"}, {"type": "null"}], "title": "Source"}, "required": false}, {"in": "query", "name": "search", "schema": {"anyOf": [{"type": "string"}, {"type": "null"}], "title": "Search"}, "required": false}, {"in": "query", "name": "search_field", "schema": {"anyOf": [{"type": "string"}, {"type": "null"}], "title": "Search Field"}, "required": false}], "responses": {"200": {"description": "OK", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/EventListOut"}}}}}, "description": "\u4e8b\u4ef6\u5217\u8868\uff0c\u652f\u6301\u7b5b\u9009\u548c\u641c\u7d22\n\nsearch_field: all | id | event_type | resource_id | batch_id", "tags": ["\u4e8b\u4ef6"]}}, "/api/v1/events/batch": {"po