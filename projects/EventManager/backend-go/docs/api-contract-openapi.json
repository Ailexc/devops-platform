, "content": {"application/json": {"schema": {"items": {"additionalProperties": true, "type": "object"}, "title": "Response", "type": "array"}}}}}, "description": "\u8fc7\u53bb 24 \u5c0f\u65f6\u6bcf\u5c0f\u65f6\u4e8b\u4ef6\u541e\u5410\u91cf", "tags": ["\u7edf\u8ba1"]}}, "/api/v1/stats/recent-failures": {"get": {"operationId": "api_v1_stats_recent_failures", "summary": "Recent Failures", "parameters": [], "responses": {"200": {"description": "OK", "content": {"application/json": {"schema": {"items": {"additionalProperties": true, "type": "object"}, "title": "Response", "type": "array"}}}}}, "description": "\u6700\u8fd1\u5931\u8d25\u4e8b\u4ef6", "tags": ["\u7edf\u8ba1"]}}, "/api/v1/handlers": {"get": {"operationId": "api_v1_handlers_list_handlers", "summary": "List Handlers", "parameters": [], "responses": {"200": {"description": "OK", "content": {"application/json": {"schema": {"items": {"additionalProperties": true, "type": "object"}, "title": "Response", "type": "array"}}}}}, "description": "\u5217\u51fa\u6240\u6709\u5df2\u6ce8\u518c Handler\uff08\u6570\u636e\u5e93\u914d\u7f6e\uff09", "tags": ["Handler"]}}, "/api/v1/handlers/event-types": {"get": {"operationId": "api_v1_handlers_list_event_types", "summary": "List Event Types", "parameters": [], "responses": {"200": {"description": "OK", "content": {"application/json": {"schema": {"items": {"additionalProperties": true, "type": "object"}, "title": "Response", "type": "array"}}}}}, "description": "\u5217\u51fa\u7cfb\u7edf\u652f\u6301\u7684\u6240\u6709\u4e8b\u4ef6\u7c7b\u578b\uff08\u4ee3\u7801\u6ce8\u518c\uff09", "tags": ["Handler"]}}, "/api/v1/test-lab/tasks": {"get": {"operationId": "api_v1_test_lab_list_demo_tasks", "summary": "List Demo Tasks", "parameters": [], "responses": {"200": {"description": "OK", "content": {"application/json": {"schema": {"items": {"$ref": "#/components/schemas/TaskInfo"}, "title": "Response", "type": "array"}}}}}, "description": "\u5217\u51fa\u6240\u6709\u53ef\u7528\u7684\u6d4b\u8bd5\u4