# ═══════════════════════════════════════════════════════
# EventFlow 部署配置（示例）
# 复制为 .env 并根据需要修改
# ═══════════════════════════════════════════════════════

# ─── 域名 ────────────────────────────────────────
# 先执行: echo '127.0.0.1 eventflow.local eventflow-api.local' >> /etc/hosts
# 然后访问 http://eventflow.local 即可
FRONTEND_DOMAIN=eventflow.local
API_DOMAIN=eventflow-api.local

# ─── 端口 ─────────────────────────────────────────
HOST_PORT_HTTP=80
HOST_PORT_TRAEFIK_DASHBOARD=8080
CONTAINER_PORT_API=8000

# ─── 数据库 ────────────────────────────────────────
POSTGRES_DB=eventdb
POSTGRES_USER=eventuser
POSTGRES_PASSWORD=eventpass

# ─── Django ──────────────────────────────────────────
DJANGO_SECRET_KEY=production-change-this-secret-key
DJANGO_DEBUG=false
ALLOWED_HOSTS=localhost,127.0.0.1

# ─── Celery ──────────────────────────────────────────
CELERY_BROKER_URL=amqp://guest:guest@rabbitmq:5672//
