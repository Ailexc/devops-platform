# ═══════════════════════════════════════════════════════
# EventFlow 部署配置
# ═══════════════════════════════════════════════════════

# ─── 域名（OrbStack 自动 DNS）────────────────────
FRONTEND_DOMAIN=frontend.event-management.orb.local
API_DOMAIN=api.event-management.orb.local

# ─── 内部容器端口（通常不需要改）────────────────
CONTAINER_PORT_API=8000

# ─── 数据库 ────────────────────────────────────────
POSTGRES_DB=eventdb
POSTGRES_USER=eventuser
POSTGRES_PASSWORD=eventpass

# ─── Django ──────────────────────────────────────────
DJANGO_SECRET_KEY=production-change-this-secret-key
DJANGO_DEBUG=false
# ALLOWED_HOSTS 由 deploy/local/.env.local 或 deploy/cloud/.env.cloud 经 compose 插值注入
# （勿在此定义，否则会覆盖 .env.local/.env.cloud 的值导致云 IP 访问 400）

# ─── Celery ──────────────────────────────────────────
CELERY_BROKER_URL=amqp://guest:guest@cmdb-event-rabbitmq:5672//
