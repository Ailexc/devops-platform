# Cloud Manager 环境变量配置
# 复制此文件为 .env 并修改配置

# ============================================
# 数据库配置
# ============================================
MYSQL_ROOT_PASSWORD=password
MYSQL_DATABASE=cloud_manager

# ============================================
# Redis配置
# ============================================
REDIS_PASSWORD=password

# ============================================
# Django配置
# ============================================
DJANGO_SECRET_KEY=your-secret-key-here-change-in-production
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=*,backend,cloud_manager_backend,cloud-manager-backend.orb.local
CORS_ALLOWED_ORIGINS=http://cloud-manager-nginx.orb.local,http://cloud-manager-backend.orb.local

# ============================================
# Nginx配置
# ============================================
NGINX_PORT=80
NGINX_SSL_PORT=443

# ============================================
# 前端配置
# ============================================
VITE_API_BASE_URL=/api

# ============================================
# 部署配置
# ============================================
# 如果使用GitHub Container Registry
# GITHUB_TOKEN=your-github-token

# 如果使用其他容器registry
# REGISTRY_URL=your-registry-url
# REGISTRY_USERNAME=your-username
# REGISTRY_PASSWORD=your-password
