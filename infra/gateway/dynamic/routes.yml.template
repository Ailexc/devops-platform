# ============================================================
# 统一网关动态路由：Host 规则 → 各系统 frontend（devops-net 服务名）
# 各目标容器必须已加入 devops-net 网络
#
# ⚠️  本文件是模板，部署时由 scripts/generate-routes.sh 自动生成 routes.yml
#     IP 地址由 deploy/<env>/.env.<env> 中的 SERVER_IP 变量注入
#     请勿手动编辑 routes.yml，应修改本模板后重新生成
# ============================================================
http:
  middlewares:
    # 认证中心 forwardAuth：校验 Authorization: Bearer <统一JWT>，通过则注入 X-Auth-* 头
    # 用于受网关保护的演示应用（mock-app / pilot-app 的 /api/*）
    auth-forward:
      forwardAuth:
        address: "http://authentication-auth-backend:8000/api/auth/verify"
        trustForwardHeader: true
        authResponseHeaders:
          - "X-Auth-User"
          - "X-Auth-Username"
          - "X-Auth-Name"
          - "X-Auth-Source"
        # 从认证服务器透传 Set-Cookie（网关会话）到浏览器
        addAuthCookiesToResponse:
          - "_gw_session"

  routers:
    portal:
      rule: "Host(`devops.orb.local`) || Host(`portal.devops.orb.local`) || Host(`__SERVER_IP__`)"
      entryPoints: ["web"]
      service: portal

    cloud:
      rule: "Host(`cloud.devops.orb.local`)"
      entryPoints: ["web"]
      service: cloud

    event:
      rule: "Host(`event.devops.orb.local`)"
      entryPoints: ["web"]
      service: event

    iam:
      rule: "Host(`iam.devops.orb.local`)"
      entryPoints: ["web"]
      service: iam

    release:
      rule: "Host(`release.devops.orb.local`)"
      entryPoints: ["web"]
      service: release

    cmdb:
      rule: "Host(`cmdb.devops.orb.local`)"
      entryPoints: ["web"]
      service: cmdb

    workflow:
      rule: "Host(`workflow.devops.orb.local`)"
      entryPoints: ["web"]
      service: workflow

    # ===== 多端口纯 IP 路由（对外预览，免 hosts 映射）=====
    cmdb-ip:
      rule: "Host(`__SERVER_IP__`)"
      entryPoints: ["web-cmdb"]
      service: cmdb

    cloud-ip:
      rule: "Host(`__SERVER_IP__`)"
      entryPoints: ["web-cloud"]
      service: cloud

    # 方式一「统一网关 forwardAuth」：/api 由网关校验统一 JWT → 注入 X-Auth-* 后直达后端（后端零鉴权，只读 X-Auth-*）
    cloud-ip-api:
      rule: "Host(`__SERVER_IP__`) && PathPrefix(`/api/`)"
      entryPoints: ["web-cloud"]
      service: cloud-backend
      middlewares:
        - auth-forward
      priority: 100

    workflow-ip:
      rule: "Host(`__SERVER_IP__`)"
      entryPoints: ["web-workflow"]
      service: workflow

    # 方式一「统一网关 forwardAuth」：工单中心 /api/v1 鉴权后直达后端
    workflow-ip-api:
      rule: "Host(`__SERVER_IP__`) && PathPrefix(`/api/v1/`)"
      entryPoints: ["web-workflow"]
      service: workflow-backend
      middlewares:
        - auth-forward
      priority: 100

    event-ip:
      rule: "Host(`__SERVER_IP__`)"
      entryPoints: ["web-event"]
      service: event

    release-ip:
      rule: "Host(`__SERVER_IP__`)"
      entryPoints: ["web-release"]
      service: release

    iam-ip:
      rule: "Host(`__SERVER_IP__`)"
      entryPoints: ["web-iam"]
      service: iam

    # 方式一「统一网关 forwardAuth」：权限中心 /api/v1 鉴权后直达后端
    iam-ip-api:
      rule: "Host(`__SERVER_IP__`) && PathPrefix(`/api/v1/`)"
      entryPoints: ["web-iam"]
      service: iam-backend
      middlewares:
        - auth-forward
      priority: 100

    # 认证 API 直连（调试/演示用）
    api-auth:
      rule: "Host(`api.auth.devops.orb.local`)"
      entryPoints: ["web"]
      service: auth-api

    # ===== Demo 应用 + 认证 API：多端口纯 IP 路由 =====
    mock-ip-api:
      rule: "Host(`__SERVER_IP__`) && PathPrefix(`/api/`)"
      entryPoints: ["web-mock"]
      service: mock-app
      middlewares:
        - auth-forward
      priority: 10

    mock-ip-home:
      rule: "Host(`__SERVER_IP__`)"
      entryPoints: ["web-mock"]
      service: mock-app
      priority: 1

    pilot-ip-api:
      rule: "Host(`__SERVER_IP__`) && PathPrefix(`/api/`)"
      entryPoints: ["web-pilot"]
      service: pilot-app
      middlewares:
        - auth-forward
      priority: 10

    pilot-ip-home:
      rule: "Host(`__SERVER_IP__`)"
      entryPoints: ["web-pilot"]
      service: pilot-app
      priority: 1

    direct-ip:
      rule: "Host(`__SERVER_IP__`)"
      entryPoints: ["web-direct"]
      service: direct-app

    oidc-ip:
      rule: "Host(`__SERVER_IP__`)"
      entryPoints: ["web-oidc"]
      service: oidc-demo

    auth-api-ip:
      rule: "Host(`__SERVER_IP__`)"
      entryPoints: ["web-auth-api"]
      service: auth-api

    # Traefik Dashboard
    traefik:
      rule: "Host(`traefik.devops.orb.local`)"
      entryPoints: ["web"]
      service: api@internal

    # Traefik Dashboard —— 独立端口纯 IP 直达（免 hosts）：http://<SERVER_IP>:8086/dashboard/
    # 放独立 entryPoint(web-dash)，不与门户 8088 的 /api 冲突
    dashboard-ip:
      rule: "Host(`__SERVER_IP__`)"
      entryPoints: ["web-dash"]
      service: api@internal

  services:
    portal:
      loadBalancer:
        servers:
          - url: "http://authentication-portal:80"

    cloud:
      loadBalancer:
        servers:
          - url: "http://cloud_manager_nginx:80"

    # 方式一「统一网关 forwardAuth」直达后端（多端口纯 IP，devops-net 服务名）
    cloud-backend:
      loadBalancer:
        servers:
          - url: "http://cloud_manager_backend:8000"

    workflow-backend:
      loadBalancer:
        servers:
          - url: "http://workflow-api:8000"

    iam-backend:
      loadBalancer:
        servers:
          - url: "http://permission-center-iam-server-1:8080"

    event:
      loadBalancer:
        servers:
          - url: "http://cmdb-event-frontend:80"

    iam:
      loadBalancer:
        servers:
          - url: "http://permission-center-frontend:80"

    release:
      loadBalancer:
        servers:
          - url: "http://release-frontend:80"

    cmdb:
      loadBalancer:
        servers:
          - url: "http://cmdb-task-frontend:80"

    workflow:
      loadBalancer:
        servers:
          - url: "http://workflow-frontend:80"

    auth-api:
      loadBalancer:
        servers:
          - url: "http://authentication-auth-backend:8000"

    # ---- Demo 应用（容器名已加入 devops-net）----
    mock-app:
      loadBalancer:
        servers:
          - url: "http://authentication-mock-app:8081"

    direct-app:
      loadBalancer:
        servers:
          - url: "http://authentication-direct-app:8003"

    pilot-app:
      loadBalancer:
        servers:
          - url: "http://authentication-pilot-app:8004"

    oidc-demo:
      loadBalancer:
        servers:
          - url: "http://authentication-oidc-demo:8005"
