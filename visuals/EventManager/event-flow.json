{
  "schema_version": 1,
  "diagram_type": "lifecycle",
  "meta": {
    "title": "事件管理系统 · 事件处理状态机",
    "locale": "zh-CN",
    "quality_profile": "showcase",
    "output": "event-flow.html",
    "viewBox": [
      1080,
      640
    ],
    "views": [
      {
        "id": "receive",
        "label": "接收与解耦",
        "focus": [
          "pending"
        ],
        "note": "POST /events 校验后落库并立即返回 202——接收与处理解耦，上游永不阻塞；随后投递队列（RabbitMQ 持久化 / asynq）。"
      },
      {
        "id": "process",
        "label": "处理与幂等",
        "focus": [
          "processing",
          "completed"
        ],
        "note": "Worker 行锁领取（SELECT FOR UPDATE）标记处理中；按 Handler 注册表路由执行；成功写结果+耗时留档，append-only 日志全程记录。"
      },
      {
        "id": "retry-dlq",
        "label": "重试与死信",
        "focus": [
          "failed",
          "dlq"
        ],
        "note": "瞬时错误指数退避重试（2^n×4s 封顶 300s + jitter，Python 5 次 / asynq 3 次）；永久错误直接死信；DLQ 支持人工重试与批量回放——急救室不是垃圾桶。"
      }
    ]
  },
  "lanes": [
    {
      "id": "main",
      "label": "主链路"
    },
    {
      "id": "event",
      "label": "失败分支"
    },
    {
      "id": "terminal",
      "label": "终态"
    }
  ],
  "states": [
    {
      "id": "pending",
