{
  "schema_version": 1,
  "diagram_type": "lifecycle",
  "meta": {
    "title": "发布系统 · 发布单全生命周期（状态机）",
    "locale": "zh-CN",
    "quality_profile": "showcase",
    "output": "release-flow.html",
    "viewBox": [
      1080,
      700
    ],
    "views": [
      {
        "id": "create-approve",
        "label": "发起与审批",
        "focus": [
          "draft",
          "pending",
          "rejected"
        ],
        "note": "创建发布单按环境自动判断审批（prod/staging 需审批，dev/test 免审批直达）；审批人动态解析——应用负责人/组长/业务线负责人，不绑定固定用户。"
      },
      {
        "id": "running-rail",
        "label": "执行主链路",
        "focus": [
          "approved",
          "running",
          "completed"
        ],
        "note": "ReleaseTask 固定 CI+CD 两步；部署策略三选一（滚动/蓝绿/灰度）；CD 成功后自动执行 ReleaseVerification，结果 JSON 留档可重跑。"
      },
      {
        "id": "recovery",
        "label": "失败与回滚兜底",
        "focus": [
          "failed",
          "rolled_back"
        ],
        "note": "失败走补偿发布只重发失败目标（selected_targets）；回滚是一等公民——rollback_from 血缘 + RollbackRecord 版本前后关系，制品不可变保证回滚确定；灰度发布支持暂停观察（canary_percent 调整）与恢复放量。"
      }
    ]
  },
