{
  "schema_version": 1,
  "diagram_type": "lifecycle",
  "meta": {
    "title": "工作流平台 · 流程实例状态机",
    "locale": "zh-CN",
    "quality_profile": "showcase",
    "output": "process-flow.html",
    "viewBox": [
      1080,
      640
    ],
    "views": [
      {
        "id": "draft-run",
        "label": "发起与运行",
        "focus": [
          "draft",
          "running"
        ],
        "note": "选择模板发起填动态表单（form-create）可暂存草稿；提交后引擎按定义 JSON 推进——审批节点生成任务签收制处理，服务调用节点立即调能力，条件节点选分支。"
      },
      {
        "id": "approve-actions",
        "label": "审批动作",
        "focus": [
          "running",
          "completed"
        ],
        "note": "同意/驳回/转办/加签/挂起恢复/终止——全部在引擎单事务+select_for_update 内原子完成；每个动作写 ApprovalRecord + django-fsm-log 留痕。"
      },
      {
        "id": "terminal-arch",
        "label": "终态与归档",
        "focus": [
          "completed",
          "archived"
        ],
        "note": "完成/驳回/取消三终态；完成后归档（ARCHIVED 冷数据分离）；状态变更全程发布事件，Webhook 经 Celery 异步 HMAC 签名投递。"
      }
    ]
  },
  "lanes": [
    {
      "id": "main",
      "label": "实例主链路"
    },
    {
      "id": "event",
      "label": "中断分支"
