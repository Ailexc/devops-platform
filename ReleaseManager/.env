# 发布系统 Demo — 环境变量配置
# COMPOSE_PROJECT_NAME 使用连字符格式，匹配 OrbStack 域名
COMPOSE_PROJECT_NAME=release-system

# 域名配置（由变量自动展开）
FRONTEND_DOMAIN=frontend.release-system.orb.local
API_DOMAIN=api.release-system.orb.local
EXECUTOR_DOMAIN=executor.release-system.orb.local

# Django 配置
# ALLOWED_HOSTS 由 deploy/local/.env.local 或 deploy/cloud/.env.cloud 经 compose 插值注入
# （勿在此定义，否则会覆盖 .env.local/.env.cloud 的值导致云 IP 访问 400）
